{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "light_primary": "{{colors.primary.light.hex}}",
    "dark_primary": "{{colors.primary.dark.hex}}",
    "light_on_primary": "{{colors.on_primary.light.hex}}",
    "dark_on_primary": "{{colors.on_primary.dark.hex}}",
    "light_secondary": "{{colors.secondary.light.hex}}",
    "dark_secondary": "{{colors.secondary.dark.hex}}",
    "light_on_secondary": "{{colors.on_secondary.light.hex}}",
    "dark_on_secondary": "{{colors.on_secondary.dark.hex}}",
    "light_surface": "{{colors.surface.light.hex}}",
    "dark_surface": "{{colors.surface.dark.hex}}",
    "light_on_surface": "{{colors.on_surface.light.hex}}",
    "dark_on_surface": "{{colors.on_surface.dark.hex}}",
    "light_surface_variant": "{{colors.surface_variant.light.hex}}",
    "dark_surface_variant": "{{colors.surface_variant.dark.hex}}",
    "light_on_surface_variant": "{{colors.on_surface_variant.light.hex}}",
    "dark_on_surface_variant": "{{colors.on_surface_variant.dark.hex}}",
    "light_background": "{{colors.surface.light.hex}}",
    "dark_background": "{{colors.surface.dark.hex}}",
    "light_on_background": "{{colors.on_surface.light.hex}}",
    "dark_on_background": "{{colors.on_surface.dark.hex}}",
    "light_error": "{{colors.error.light.hex}}",
    "dark_error": "{{colors.error.dark.hex}}",
    "light_on_error": "{{colors.on_error.light.hex}}",
    "dark_on_error": "{{colors.on_error.dark.hex}}",
    "light_outline": "{{colors.outline.light.hex}}",
    "dark_outline": "{{colors.outline.dark.hex}}",
    "light_outline_variant": "{{colors.outline_variant.light.hex}}",
    "dark_outline_variant": "{{colors.outline_variant.dark.hex}}"
  },
  "theme": {
    "primary": {
      "dark": "dark_primary",
      "light": "light_primary"
    },
    "secondary": {
      "dark": "dark_secondary",
      "light": "light_secondary"
    },
    "accent": {
      "dark": "dark_primary",
      "light": "light_primary"
    },
    "error": {
      "dark": "dark_error",
      "light": "light_error"
    },
    "warning": {
      "dark": "dark_secondary",
      "light": "light_secondary"
    },
    "success": {
      "dark": "dark_secondary",
      "light": "light_secondary"
    },
    "info": {
      "dark": "dark_primary",
      "light": "light_primary"
    },
    "text": {
      "dark": "dark_on_surface",
      "light": "light_on_surface"
    },
    "textMuted": {
      "dark": "dark_on_surface_variant",
      "light": "light_on_surface_variant"
    },
    "background": {
      "dark": "dark_background",
      "light": "light_background"
    },
    "backgroundPanel": {
      "dark": "dark_surface_variant",
      "light": "light_surface_variant"
    },
    "backgroundElement": {
      "dark": "dark_surface_variant",
      "light": "light_surface_variant"
    },
    "border": {
      "dark": "dark_outline_variant",
      "light": "light_outline_variant"
    },
    "borderActive": {
      "dark": "dark_outline",
      "light": "light_outline"
    },
    "borderSubtle": {
      "dark": "dark_outline_variant",
      "light": "light_outline_variant"
    },
    "diffAdded": {
      "dark": "dark_secondary",
      "light": "light_secondary"
    },
    "diffRemoved": {
      "dark": "dark_error",
      "light": "light_error"
    },
    "diffContext": {
      "dark": "dark_surface_variant",
      "light": "light_surface_variant"
    },
    "diffHunkHeader": {
      "dark": "dark_surface_variant",
      "light": "light_surface_variant"
    },
    "diffHighlightAdded": {
      "dark": "dark_secondary",
      "light": "light_secondary"
    },
    "diffHighlightRemoved": {
      "dark": "dark_error",
      "light": "light_error"
    },
    "diffAddedBg": {
      "dark": "dark_surface_variant",
      "light": "light_surface_variant"
    },
    "diffRemovedBg": {
      "dark": "dark_surface_variant",
      "light": "light_surface_variant"
    },
    "diffContextBg": {
      "dark": "dark_surface_variant",
      "light": "light_surface_variant"
    },
    "diffLineNumber": {
      "dark": "dark_on_surface_variant",
      "light": "light_on_surface_variant"
    },
    "diffAddedLineNumberBg": {
      "dark": "dark_surface_variant",
      "light": "light_surface_variant"
    },
    "diffRemovedLineNumberBg": {
      "dark": "dark_surface_variant",
      "light": "light_surface_variant"
    },
    "markdownText": {
      "dark": "dark_on_surface",
      "light": "light_on_surface"
    },
    "markdownHeading": {
      "dark": "dark_primary",
      "light": "light_primary"
    },
    "markdownLink": {
      "dark": "dark_primary",
      "light": "light_primary"
    },
    "markdownLinkText": {
      "dark": "dark_secondary",
      "light": "light_secondary"
    },
    "markdownCode": {
      "dark": "dark_secondary",
      "light": "light_secondary"
    },
    "markdownBlockQuote": {
      "dark": "dark_surface_variant",
      "light": "light_surface_variant"
    },
    "markdownEmph": {
      "dark": "dark_secondary",
      "light": "light_secondary"
    },
    "markdownStrong": {
      "dark": "dark_primary",
      "light": "light_primary"
    },
    "markdownHorizontalRule": {
      "dark": "dark_surface_variant",
      "light": "light_surface_variant"
    },
    "markdownListItem": {
      "dark": "dark_primary",
      "light": "light_primary"
    },
    "markdownListEnumeration": {
      "dark": "dark_secondary",
      "light": "light_secondary"
    },
    "markdownImage": {
      "dark": "dark_primary",
      "light": "light_primary"
    },
    "markdownImageText": {
      "dark": "dark_secondary",
      "light": "light_secondary"
    },
    "markdownCodeBlock": {
      "dark": "dark_on_surface",
      "light": "light_on_surface"
    },
    "syntaxComment": {
      "dark": "dark_on_surface_variant",
      "light": "light_on_surface_variant"
    },
    "syntaxKeyword": {
      "dark": "dark_primary",
      "light": "light_primary"
    },
    "syntaxFunction": {
      "dark": "dark_secondary",
      "light": "light_secondary"
    },
    "syntaxVariable": {
      "dark": "dark_on_surface",
      "light": "light_on_surface"
    },
    "syntaxString": {
      "dark": "dark_secondary",
      "light": "light_secondary"
    },
    "syntaxNumber": {
      "dark": "dark_secondary",
      "light": "light_secondary"
    },
    "syntaxType": {
      "dark": "dark_primary",
      "light": "light_primary"
    },
    "syntaxOperator": {
      "dark": "dark_on_surface",
      "light": "light_on_surface"
    },
    "syntaxPunctuation": {
      "dark": "dark_on_surface_variant",
      "light": "light_on_surface_variant"
    }
  }
}
